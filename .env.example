# Trillion Trader Environment Variables Guide
# Do not commit real credentials to this or any other file.

# ==========================================
# Frontend Variables (frontend/.env)
# ==========================================
# The base URL of the backend API
VITE_API_BASE_URL=https://api.trillion-traders.example.com/api/v1

# ==========================================
# Backend Variables (backend/.env)
# ==========================================
# Set to 'prod' for production environment
SPRING_PROFILES_ACTIVE=prod

# MongoDB Connection String (e.g., from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trillion_traders?retryWrites=true&w=majority

# JWT Secret Key (Generate a secure, random 256-bit string)
JWT_SECRET=your_secure_random_jwt_secret_key_at_least_256_bits

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=https://trillion-traders.example.com,https://www.trillion-traders.example.com
